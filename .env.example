# CalBridge Portal — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git

# ============================================================
# App
# ============================================================
NODE_ENV=development                    # development | production
BASE_URL=http://localhost:3000          # prod: https://app.teamcalbridge.com
SESSION_SECRET=                         # generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ENABLE_SCHEDULER=false                  # true in production

# ============================================================
# Amazon — Login with Amazon (LWA)
# Used for: Advertising API (Ads + DSP)
# Register at: developer.amazon.com
# ============================================================
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=

# ============================================================
# Amazon SP-API — Sandbox
# Used for: local development and testing
# ============================================================
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=

# ============================================================
# Amazon SP-API — Production
# Used when NODE_ENV=production
# Requires Amazon app review approval before real sellers can connect
# ============================================================
SPAPI_PROD_CLIENT_ID=
SPAPI_PROD_CLIENT_SECRET=

# ============================================================
# Snowflake
# ============================================================
SNOWFLAKE_ACCOUNT=                      # e.g. ASKDLKL-DXB35118
SNOWFLAKE_USER=CALBRIDGE_SVC
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=CALBRIDGE_WH
SNOWFLAKE_DATABASE=CALBRIDGE
SNOWFLAKE_SCHEMA=SANDBOX               # SANDBOX | PROD

# ============================================================
# Email — Resend
# ash@teamcalbridge.com sends all outbound email
# ============================================================
RESEND_API_KEY=
EMAIL_FROM=ash@teamcalbridge.com
EMAIL_CC=abe@teamcalbridge.com

# ============================================================
# Stripe — Billing
# Get keys from: dashboard.stripe.com/apikeys
# Webhook secret: stripe listen --forward-to localhost:3000/billing/webhook
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — create products in Stripe dashboard, then paste IDs here
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ============================================================
# OpenRouter — AI Chat (used by the client portal chatbot)
# Get key at: openrouter.ai/keys
# ============================================================
OPENROUTER_API_KEY=

# ============================================================
# Token Encryption — AES-256-GCM
# Encrypts OAuth access_token + refresh_token at rest in Snowflake
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
TOKEN_ENCRYPTION_KEY=                  # 64 hex chars (32 bytes)

# ============================================================
# Operations Monitoring — Ash Ops + Platform Costs dashboards
# All values are optional; defaults shown
# ============================================================
AZURE_VM_MONTHLY_COST=50       # Monthly Azure VM cost in USD
DOMAIN_ANNUAL_COST=20          # Annual domain/SSL cost in USD (divided by 12 for monthly)
GITHUB_MONTHLY_COST=0          # GitHub Teams/Enterprise monthly cost
OPENROUTER_CHATBOT_KEY=        # Separate OpenRouter key for chatbot (if different from main key)
